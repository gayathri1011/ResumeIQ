# Application environment — copy to .env and fill in real values locally.
# Never commit .env files.

# --- App ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (MongoDB) ---
# Local: mongodb://localhost:27017
# Atlas: copy from Connect → Drivers; must include authSource=admin, e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/resumeiq?authSource=admin&retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=resumeiq
EMBEDDING_DIMENSIONS=768

# --- CORS (comma-separated origins) ---
# Include localhost plus any custom frontend domain.
# Vercel preview/production *.vercel.app URLs are also allowed via CORS_ORIGIN_REGEX.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)+vercel\.app

# --- JWT / Auth ---
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_MINUTE=30

# --- AI Provider (Groq) ---
# Get AI_API_KEY from https://console.groq.com/keys (starts with gsk_)
AI_PROVIDER=groq
AI_API_KEY=replace-with-your-groq-api-key
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_EMBEDDING_MODEL=nomic-embed-text-v1_5
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MOCK_MODE=false

# --- File Upload ---
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=pdf,docx,png,jpg,jpeg,webp,gif
FILE_STORAGE_BACKEND=local
FILE_STORAGE_PATH=./uploads

# --- S3 (optional) ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
